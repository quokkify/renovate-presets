{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Disable competing updates inside template-owned workflows; project-toolkit owns those versions and delivers them through copier update.",
      "matchFileNames": [".github/workflows/codeql.yml", ".github/workflows/copier-update.yml", ".github/workflows/gitleaks.yml", ".github/workflows/release.yml", ".github/workflows/validate.yml"],
      "enabled": false
    },
    {
      "description": "Copier updates are managed by project-toolkit fleet automation",
      "matchManagers": ["copier"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "automerge": true
    }
  ]
}
