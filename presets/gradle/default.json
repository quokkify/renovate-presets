    "github>ylazakovich/renovate-config//presets/gradle/modules/changelogs",
    "github>ylazakovich/renovate-config//presets/gradle/modules/compatibility",
    "github>ylazakovich/renovate-config//presets/gradle/modules/disabled"
  ]
}
