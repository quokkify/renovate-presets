{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Compatibility notes for interdependent Gradle/Maven packages (Hibernate, Jakarta, hypersistence-utils).",
  "packageRules": [
    {
      "description": "Hibernate/Jakarta/hypersistence-utils should be compatible",
      "matchPackageNames": [
        "org.hibernate.orm:*",
        "jakarta.persistence:jakarta.persistence-api",
        "io.hypersistence:*"
      ],
      "prBodyNotes": [
        "### Compatibility",
        "\nCheck compatibility with `jakarta` [here](https://hibernate.org/orm/releases/#compatibility-matrix)",
        "\nCheck compatibility with `hypersistence-utils` [here](https://github.com/vladmihalcea/hypersistence-utils?tab=readme-ov-file#installation-guide)"
      ],
      "matchManagers": ["gradle"]
    }
  ]
}
